{
  "meta": {
    "output_path": "assets/css/navbar.css",
    "type": "css"
  },
  "sections": [
    {
      "selector": ".navbar",
      "variables": [
        { "name": "background-color", "value": "var(--nav-bg)" },
        { "name": "border-bottom", "value": "1px solid var(--fg)"}
      ]
    },
    {
      "selector": ".navbar .navbar-title,\n.navbar .nav-link",
      "variables": [
        { "name": "color", "value": "var(--fg)" },
        { "name": "padding", "value": "1px" },
        { "name": "border-bottom", "value": "1px solid transparent"}
      ]
    },
    {
      "selector": ".navbar .nav-link:hover",
      "variables": [
        { "name": "color", "value": "var(--brand-color-1-hover)" }
      ]
    },
    {
      "selector": ".navbar .nav-link.active,\n.navbar .nav-link:focus",
      "variables": [
        { "name": "color", "value": "var(--brand-color-1-active)" }
      ]
    },
    {
      "selector": ".navbar .quarto-navbar-tools .quarto-navigation-tool",
      "variables": [
        { "name": "color", "value": "var(--brand-color-2)" }
      ]
    },
    {
      "selector": ".navbar #quarto-search.type-overlay .aa-Autocomplete svg.aa-SubmitIcon",
      "variables": [
        { "name": "color", "value": "var(--brand-color-2)" }
      ]
    },
    {
      "selector": ".quarto-color-scheme-toggle i",
      "variables": [
        { "name": "color", "value": "var(--brand-color-2)" },
        { "name": "opacity", "value": "1 !important" }
      ]
    },
    {
      "selector": ".navbar .quarto-color-scheme-toggle:not(.alternate) .bi::before",
      "variables": [
        { "name": "background-image", "value": "url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='var(--brand-color-1)' class='bi bi-toggle-off' viewBox='0 0 16 16'><path d='M11 4a4 4 0 0 1 0 8H8a4.992 4.992 0 0 0 2-4 4.992 4.992 0 0 0-2-4h3zm-6 8a4 4 0 1 1 0-8 4 4 0 0 1 0 8zM0 8a5 5 0 0 0 5 5h6a5 5 0 0 0 0-10H5a5 5 0 0 0-5 5z'/></svg>\")" }
      ]
    },
    {
      "selector": ".quarto-banner nav.quarto-secondary-nav",
      "variables": [
        { "name": "background-color", "value": "var(--nav-bg)" },
        { "name": "color", "value": "var(--fg)" },
        { "name": "border-bottom", "value": "1px solid var(--brand-color-1)" }
      ]
    },
    {
      "selector": ".quarto-secondary-nav-title",
      "variables": [
        { "name": "color", "value": "var(--brand-color-1)" }
      ]
    },
    {
      "selector": ".quarto-secondary-nav .quarto-btn-toggle",
      "variables": [
        { "name": "color", "value": "var(--brand-color-1)" }
      ]
    },
    {
      "selector": ".sidebar-navigation a",
      "variables": [
        { "name": "color", "value": "var(--fg)" }
      ]
    },
    {
      "selector": ".quarto-light .navbar-toggler-icon",
      "variables": [
        { "name": "--bs-navbar-toggler-icon-bg", "value": "url(\"data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'><path stroke='%23000000' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/></svg>\")" }
      ]
    }
  ]
}
